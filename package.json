{
  "name": "codex-reset-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first Codex reset signal tracker for X, Cloudflare Workers, and email alerts.",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run backtest && npm run deploy:dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backtest": "node scripts/backtest.mjs --check",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply codex-reset-watcher-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply codex-reset-watcher-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
