{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-reset-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_TIMEZONE": "Asia/Shanghai",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_MIN_SEVERITY": "medium"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-reset-watcher-db",
      "database_id": "7f5682be-d239-42ac-b377-619ca9b475b9",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
