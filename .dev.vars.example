# Never commit the real values. Copy to .dev.vars for local development.
X_BEARER_TOKEN=replace_me
ADMIN_TOKEN=replace_with_a_long_random_value
DASHSCOPE_API_KEY=

# Optional email alerts through Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Codex Reset Watcher <alerts@example.com>
ALERT_EMAIL_TO=you@example.com

# Optional cloud-native DingTalk robot group messages (not DING).
# Store real credentials only as Worker secrets.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_GROUP_ID=

# Optional cloud webhook notifications. Production and isolated test groups differ.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
FEISHU_TEST_WEBHOOK_URL=
FEISHU_TEST_WEBHOOK_SECRET=
WECOM_WEBHOOK_URL=
WECOM_TEST_WEBHOOK_URL=
# Temporary, test-route-only token. Remove after cloud verification.
WEBHOOK_TEST_TOKEN=

# Owner-only Weixin cloud probe. Configure only after explicit cloud-session approval.
WEIXIN_TEST_BOT_TOKEN=
WEIXIN_TEST_OWNER_ID=
WEIXIN_BOT_TOKEN=
WEIXIN_OWNER_ID=
# Enable only after the authorized owner cloud probe succeeds.
WEIXIN_NOTIFICATIONS_ENABLED=false

# Official QQ Bot owner probe. OpenID must come from this app's authenticated C2C event.
QQ_TEST_APP_ID=
QQ_TEST_APP_SECRET=
QQ_TEST_OWNER_OPENID=
