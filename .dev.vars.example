# Never commit the real values. Copy to .dev.vars for local development.
X_BEARER_TOKEN=replace_me
ADMIN_TOKEN=replace_with_a_long_random_value
DASHSCOPE_API_KEY=

# Optional email alerts through Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Codex Reset Watcher <alerts@example.com>
ALERT_EMAIL_TO=you@example.com

# Optional cloud-native DingTalk robot group messages (not DING).
# Store real credentials only as Worker secrets.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_GROUP_ID=
